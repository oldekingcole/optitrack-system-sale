{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optitrack-sales-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8000,https://www.example.com,https://example.com",
    "PUBLIC_SITE_URL": "https://www.example.com",
    "NOTIFY_EMAIL": "sales@example.com",
    "FROM_EMAIL": "OptiTrack System Sale <inquiries@example.com>",
    "CONFIRMATION_FROM_EMAIL": "OptiTrack System Sale <inquiries@example.com>",
    "SEND_BUYER_CONFIRMATION": "false",
    "TURNSTILE_REQUIRED": "true",
    "TURNSTILE_EXPECTED_HOSTNAME": "www.example.com",
    "MAX_SUBMISSIONS_PER_HOUR": "5"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "optitrack-inquiries",
      "database_id": "a3137954-565e-48f9-8064-edd684c8bdd0",
      "migrations_dir": "migrations"
    }
  ]
}
